{
  "name": "agent-desk",
  "productName": "Relay",
  "version": "1.11.1",
  "description": "Run many Claude Code agents side by side",
  "private": true,
  "type": "module",
  "main": "electron/main.mjs",
  "scripts": {
    "postinstall": "chmod +x node_modules/node-pty/prebuilds/*/spawn-helper 2>/dev/null || true",
    "start": "node server.mjs",
    "check": "node check.mjs",
    "app": "electron .",
    "build:native": "mkdir -p native/build && swiftc -O -target \"$(uname -m)-apple-macos12\" native/listen.swift -o native/build/desk-listen -Xlinker -sectcreate -Xlinker __TEXT -Xlinker __info_plist -Xlinker native/Info.plist",
    "build:art": "electron build/art/render.mjs",
    "dist": "npm run build:native && npm run build:art && electron-builder --mac dmg",
    "dist:debug": "npm run build:native && npm run build:art && electron-builder --mac dmg -c.appId=com.aahan.relay.debug -c.productName='Relay Debug' -c.extraMetadata.productName='Relay Debug' -c.dmg.title='Relay Debug' -c.artifactName='Relay-Debug-${version}-${arch}.${ext}'"
  },
  "dependencies": {
    "@xterm/addon-fit": "0.11.0",
    "@xterm/addon-serialize": "0.14.0",
    "@xterm/addon-webgl": "0.19.0",
    "@xterm/headless": "6.0.0",
    "@xterm/xterm": "6.0.0",
    "monaco-editor": "0.57.0",
    "node-pty": "1.1.0",
    "ws": "8.22.0"
  },
  "devDependencies": {
    "electron": "44.5.1",
    "electron-builder": "26.15.3"
  },
  "build": {
    "appId": "com.aahan.relay",
    "productName": "Relay",
    "npmRebuild": false,
    "files": [
      "electron/**",
      "server.mjs",
      "lib/**",
      "public/**",
      "shell/**",
      "!node_modules/monaco-editor/{esm,dev}/**",
      "!node_modules/node-pty/{deps,src,third_party,prebuilds/win32-*}/**",
      "!**/*.map"
    ],
    "asarUnpack": [
      "node_modules/node-pty/**",
      "shell/**"
    ],
    "extraResources": [
      {
        "from": "native/build/desk-listen",
        "to": "desk-listen"
      }
    ],
    "mac": {
      "category": "public.app-category.developer-tools",
      "target": "dmg",
      "icon": "build/icon.icns",
      "identity": "-",
      "hardenedRuntime": true,
      "notarize": false,
      "extendInfo": {
        "NSMicrophoneUsageDescription": "Relay listens to your voice so you can talk to your agents instead of typing.",
        "NSSpeechRecognitionUsageDescription": "Relay turns your speech into text on this Mac so you can talk to your agents."
      },
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.plist"
    },
    "dmg": {
      "title": "Relay",
      "icon": "build/icon.icns",
      "background": "build/background.tiff",
      "iconSize": 112,
      "window": {
        "width": 660,
        "height": 420
      },
      "contents": [
        {
          "x": 180,
          "y": 235,
          "type": "file"
        },
        {
          "x": 480,
          "y": 235,
          "type": "link",
          "path": "/Applications"
        }
      ]
    },
    "electronFuses": {
      "runAsNode": false,
      "enableNodeOptionsEnvironmentVariable": false,
      "enableNodeCliInspectArguments": false,
      "enableEmbeddedAsarIntegrityValidation": true,
      "onlyLoadAppFromAsar": true,
      "enableCookieEncryption": true
    }
  },
  "license": "MIT"
}
